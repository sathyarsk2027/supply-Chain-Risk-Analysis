{
  "openapi": "3.1.0",
  "info": {
    "title": "Supply Chain Risk Monitor API",
    "description": "REST API for the Supply Chain Risk Monitor platform. Provides real-time access to global supply chain disruption news articles, semantic AI-powered search, country-level risk scoring, and feed synchronization. Designed for integration with AI agents, logistics dashboards, and risk management systems.\n\n### Versioning Strategy\nThis API uses URL path versioning (`/api/v1/...`) with an unversioned default alias (`/api/...`) pointing to the latest stable release. Clients can also supply the `X-API-Version: 1.0` header.\n\n### Deprecation Policy\nDeprecation notices are published at least 6 months prior to retirement. Deprecated endpoints return RFC 8594 standard headers: `Deprecation: @<timestamp>` and `Sunset: <date>`.\n\n### Rate Limiting\nRequests are limited to 100 requests per minute per IP. All responses return standard RFC rate-limit headers: `RateLimit-Limit`, `RateLimit-Remaining`, `RateLimit-Reset`, `RateLimit-Policy`, as well as legacy `X-RateLimit-*` headers. When exceeded, the API returns HTTP 429 with a `Retry-After` header.",
    "version": "1.0.0",
    "contact": {
      "name": "Supply Chain Risk Monitor Developer Support",
      "url": "https://supply-chain-risk-analysis-po64.vercel.app/developers",
      "email": "sathyarsk2027@gmail.com"
    },
    "license": {
      "name": "MIT"
    },
    "x-api-versioning": {
      "current_version": "v1",
      "strategy": "URL path (/api/v1/) and optional X-API-Version header",
      "supported_versions": ["v1"],
      "deprecation_policy": "Deprecation announced at least 6 months in advance with RFC 8594 Sunset and Deprecation HTTP headers."
    },
    "x-rate-limit": {
      "quota": "100 requests per minute per client IP",
      "headers": [
        "RateLimit-Limit",
        "RateLimit-Remaining",
        "RateLimit-Reset",
        "RateLimit-Policy",
        "Retry-After",
        "X-RateLimit-Limit",
        "X-RateLimit-Remaining",
        "X-RateLimit-Reset"
      ]
    }
  },
  "servers": [
    {
      "url": "https://supply-chain-risk-analysis-po64.vercel.app/api/v1",
      "description": "Production API v1 (Recommended versioned endpoint)"
    },
    {
      "url": "https://supply-chain-risk-analysis-po64.vercel.app/api",
      "description": "Production API (Unversioned default alias)"
    }
  ],
  "paths": {
    "/api/v1/articles": {
      "get": {
        "operationId": "listArticles",
        "summary": "List all supply chain news articles",
        "description": "Returns ingested supply chain disruption news articles, ordered by publication date descending. Supports filtering by disruption category, news source, country, and result limit. Compatible with LLM function calling.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of articles to return (1-500). Defaults to 50.",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter by disruption category (e.g., 'Port Congestion', 'Labor Strike', 'Weather Event', 'Regulatory Changes').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Filter by news publisher or RSS feed source name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter articles that mention a specific country by name or ISO code.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of news articles sorted by most recent first.",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimit-Limit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimit-Remaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimit-Reset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NewsArticle"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (100 req/min quota)",
            "headers": {
              "Retry-After": { "$ref": "#/components/headers/Retry-After" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles": {
      "get": {
        "operationId": "listArticlesAlias",
        "summary": "List all supply chain news articles (unversioned alias)",
        "description": "Unversioned alias for /api/v1/articles. Returns ingested supply chain disruption news articles.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of articles to return (1-500).",
            "schema": { "type": "integer", "default": 50 }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter by disruption category.",
            "schema": { "type": "string" }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Filter by news publisher source.",
            "schema": { "type": "string" }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by country.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of news articles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/NewsArticle" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/articles/sync": {
      "post": {
        "operationId": "syncArticles",
        "summary": "Trigger live RSS feed synchronization",
        "description": "Polls all configured RSS feeds and NewsAPI sources for new supply chain news articles. Newly discovered articles are processed through the NLP pipeline (entity extraction, risk categorization, vector embedding) and stored in the database. Returns the count of new articles ingested.",
        "tags": ["Articles"],
        "requestBody": {
          "required": false,
          "description": "Optional synchronization parameters to target specific feeds or force re-indexing.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              },
              "example": {
                "force": false,
                "sources": ["SupplyChainBrain", "FreightWaves"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sync completed successfully with count of new articles.",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimit-Limit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimit-Remaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": { "Retry-After": { "$ref": "#/components/headers/Retry-After" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles/sync": {
      "post": {
        "operationId": "syncArticlesAlias",
        "summary": "Trigger live RSS feed synchronization (unversioned alias)",
        "description": "Unversioned alias for /api/v1/articles/sync.",
        "tags": ["Articles"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SyncRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sync completed successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SyncResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/articles/sources": {
      "get": {
        "operationId": "getArticleSources",
        "summary": "Get article count breakdown by source",
        "description": "Returns a list of all news sources along with the count of articles from each source. Supports filtering by minimum article threshold and count limit.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "minArticles",
            "in": "query",
            "required": false,
            "description": "Minimum article count threshold for returned sources. Defaults to 1.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of sources to return. Defaults to 50.",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source breakdown with article counts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceCount"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles/sources": {
      "get": {
        "operationId": "getArticleSourcesAlias",
        "summary": "Get article count breakdown by source (unversioned alias)",
        "description": "Unversioned alias for /api/v1/articles/sources.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "minArticles",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Source breakdown.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SourceCount" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/query": {
      "post": {
        "operationId": "semanticSearch",
        "summary": "Semantic AI search across articles",
        "description": "Performs a semantic search across all ingested articles using vector embeddings (pgvector cosine similarity). Query text is embedded via the NLP service and compared against article embeddings. Returns ranked matches with relevance scores and an optional AI summary.",
        "tags": ["Search"],
        "requestBody": {
          "required": true,
          "description": "Search query parameters containing the natural language query and optional retrieval limit.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              },
              "example": {
                "query": "port congestion in Southeast Asia",
                "topK": 10
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results with ranked matches and AI summary.",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimit-Limit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimit-Remaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or empty query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/query": {
      "post": {
        "operationId": "semanticSearchAlias",
        "summary": "Semantic AI search across articles (unversioned alias)",
        "description": "Unversioned alias for /api/v1/query.",
        "tags": ["Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QueryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/QueryResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/countries/active": {
      "get": {
        "operationId": "getActiveCountries",
        "summary": "List countries with active disruption coverage",
        "description": "Returns a list of countries that have matching news articles in the current dataset. Each country includes its ISO code, name, flag emoji, and geographic coordinates for map visualization. Supports optional region filtering.",
        "tags": ["Countries"],
        "parameters": [
          {
            "name": "minRiskArticles",
            "in": "query",
            "required": false,
            "description": "Filter countries having at least this number of active articles. Defaults to 1.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Filter by geographic region (e.g. 'Asia', 'Europe', 'Americas', 'Middle East', 'Africa').",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of active country pins with geo-coordinates.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryPin"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/countries/active": {
      "get": {
        "operationId": "getActiveCountriesAlias",
        "summary": "List countries with active disruption coverage (unversioned alias)",
        "description": "Unversioned alias for /api/v1/countries/active.",
        "tags": ["Countries"],
        "parameters": [
          {
            "name": "minRiskArticles",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of active country pins.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CountryPin" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/countries/risk": {
      "get": {
        "operationId": "getCountryRisk",
        "summary": "Get risk assessment for a specific country",
        "description": "Computes a real-time, recency-weighted risk score for a country based on matching supply chain news articles. Returns an overall risk score (0-100), categorical breakdown (geopolitical, logistics, weather, market), key risk driver highlights, and matched articles.",
        "tags": ["Countries"],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Country name to assess risk for (e.g., 'India', 'United States', 'China', 'Germany').",
            "schema": {
              "type": "string"
            },
            "example": "India"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Lookback window in days for recency weighting (default 30 days, min 1, max 365).",
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 365
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Country risk assessment with scores, status, and matched articles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryRiskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or empty country query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/countries/risk": {
      "get": {
        "operationId": "getCountryRiskAlias",
        "summary": "Get risk assessment for a specific country (unversioned alias)",
        "description": "Unversioned alias for /api/v1/countries/risk.",
        "tags": ["Countries"],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Country risk assessment.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CountryRiskResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/digest/ping": {
      "get": {
        "operationId": "pingDigestService",
        "summary": "Health check for the digest service",
        "description": "Ping endpoint to verify server readiness and wake up background workers. Supports optional verbose status flag.",
        "tags": ["Digest"],
        "parameters": [
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "description": "Whether to return extended health telemetry, uptime, and memory usage.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "awake"
                    },
                    "message": {
                      "type": "string",
                      "example": "Server is ready."
                    },
                    "version": {
                      "type": "string",
                      "example": "1.0.0"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/digest/ping": {
      "get": {
        "operationId": "pingDigestServiceAlias",
        "summary": "Health check for the digest service (unversioned alias)",
        "description": "Unversioned alias for /api/v1/digest/ping.",
        "tags": ["Digest"],
        "responses": {
          "200": {
            "description": "Server is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ApiVersionHeader": {
        "name": "X-API-Version",
        "in": "header",
        "required": false,
        "description": "Target API version. Supported values: '1.0', '1'. Defaults to '1.0'.",
        "schema": {
          "type": "string",
          "default": "1.0",
          "enum": ["1.0", "1"]
        }
      }
    },
    "headers": {
      "RateLimit-Limit": {
        "description": "The maximum number of allowed requests in the current 60-second window (standard quota: 100).",
        "schema": {
          "type": "integer",
          "example": 100
        }
      },
      "RateLimit-Remaining": {
        "description": "The number of remaining requests allowed in the current 60-second window.",
        "schema": {
          "type": "integer",
          "example": 98
        }
      },
      "RateLimit-Reset": {
        "description": "Number of seconds until the current rate limit window resets.",
        "schema": {
          "type": "integer",
          "example": 45
        }
      },
      "RateLimit-Policy": {
        "description": "The rate limit quota policy per RFC draft specification.",
        "schema": {
          "type": "string",
          "example": "100;w=60"
        }
      },
      "Retry-After": {
        "description": "Number of seconds client should wait before making subsequent requests after a 429 response.",
        "schema": {
          "type": "integer",
          "example": 60
        }
      },
      "Sunset": {
        "description": "RFC 8594 Sunset date when a deprecated version will be retired.",
        "schema": {
          "type": "string",
          "example": "Fri, 31 Dec 2027 23:59:59 GMT"
        }
      },
      "Deprecation": {
        "description": "RFC 8594 Deprecation indicator or date.",
        "schema": {
          "type": "string",
          "example": "false"
        }
      }
    },
    "schemas": {
      "NewsArticle": {
        "type": "object",
        "description": "A supply chain disruption news article.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique article ID.",
            "example": 142
          },
          "title": {
            "type": "string",
            "description": "Article headline.",
            "example": "Red Sea shipping diversions add 10-14 days to Asia-Europe transit times"
          },
          "source": {
            "type": "string",
            "description": "News publisher name or RSS feed source.",
            "example": "SupplyChainBrain"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Original article URL.",
            "example": "https://www.supplychainbrain.com/articles/38912"
          },
          "category": {
            "type": "string",
            "description": "Disruption category assigned by NLP pipeline.",
            "example": "Port Congestion"
          },
          "entities": {
            "type": "array",
            "description": "Named entities (ports, countries, companies) extracted from the article.",
            "items": {
              "type": "string"
            },
            "example": ["Red Sea", "Suez Canal", "Maersk", "Rotterdam"]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Publication timestamp in ISO 8601 format.",
            "example": "2026-09-30T10:15:00Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Ingestion timestamp in ISO 8601 format.",
            "example": "2026-09-30T10:30:12Z"
          }
        },
        "required": ["id", "title", "source", "url"]
      },
      "SyncRequest": {
        "type": "object",
        "description": "Request body for triggering feed synchronization.",
        "properties": {
          "force": {
            "type": "boolean",
            "description": "Force re-polling of all feeds even if recently polled.",
            "default": false
          },
          "sources": {
            "type": "array",
            "description": "Optional list of specific feed names to synchronize.",
            "items": {
              "type": "string"
            },
            "example": ["SupplyChainBrain", "FreightWaves"]
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "description": "Result of an RSS feed synchronization.",
        "properties": {
          "message": {
            "type": "string",
            "example": "Sync completed successfully."
          },
          "newArticles": {
            "type": "integer",
            "description": "Count of new articles ingested and processed.",
            "example": 14
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T12:00:00Z"
          }
        },
        "required": ["message", "newArticles"]
      },
      "SourceCount": {
        "type": "object",
        "description": "Article count for a specific news source.",
        "properties": {
          "source": {
            "type": "string",
            "description": "Name of the news source.",
            "example": "FreightWaves"
          },
          "count": {
            "type": "integer",
            "description": "Total number of articles from this source.",
            "example": 47
          }
        },
        "required": ["source", "count"]
      },
      "QueryRequest": {
        "type": "object",
        "description": "Request body for semantic search across articles.",
        "properties": {
          "query": {
            "type": "string",
            "description": "The natural language search query. Can describe a scenario, disruption type, region, or company.",
            "example": "port congestion in Southeast Asia"
          },
          "topK": {
            "type": "integer",
            "description": "Maximum number of semantically relevant articles to retrieve (1-50). Defaults to 10.",
            "default": 10,
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": ["query"]
      },
      "QueryResponse": {
        "type": "object",
        "description": "Results from semantic AI search.",
        "properties": {
          "query": {
            "type": "string",
            "description": "The original search query.",
            "example": "port congestion in Southeast Asia"
          },
          "matches": {
            "type": "array",
            "description": "Ranked article matches ordered by semantic similarity score.",
            "items": {
              "type": "object",
              "properties": {
                "article": {
                  "$ref": "#/components/schemas/NewsArticle"
                },
                "score": {
                  "type": "number",
                  "format": "float",
                  "description": "Cosine similarity score (0.0 to 1.0).",
                  "example": 0.87
                }
              }
            }
          },
          "summary": {
            "type": "string",
            "description": "AI-generated synthesis of findings across matched articles.",
            "example": "Multiple reports indicate increasing vessel wait times at Singapore and Port Klang due to weather delays and rerouted Red Sea cargo."
          }
        },
        "required": ["query", "matches"]
      },
      "CountryPin": {
        "type": "object",
        "description": "Geographic pin for a country with active disruption news.",
        "properties": {
          "country": {
            "type": "string",
            "description": "Full country name.",
            "example": "India"
          },
          "code": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code.",
            "example": "IN"
          },
          "flag": {
            "type": "string",
            "description": "Country flag emoji.",
            "example": "🇮🇳"
          },
          "lat": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate for map placement.",
            "example": 20.5937
          },
          "lng": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate for map placement.",
            "example": 78.9629
          },
          "articleCount": {
            "type": "integer",
            "description": "Number of active disruption articles for this country.",
            "example": 8
          }
        },
        "required": ["country", "code", "lat", "lng"]
      },
      "CountryRiskResponse": {
        "type": "object",
        "description": "Comprehensive risk assessment for a specific country.",
        "properties": {
          "hasData": {
            "type": "boolean",
            "description": "Whether any matching articles were found."
          },
          "countryName": {
            "type": "string",
            "description": "The queried country name."
          },
          "baseScore": {
            "type": "integer",
            "description": "Overall risk score (0-100).",
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "description": "Human-readable risk level.",
            "enum": ["LOW RISK", "MODERATE RISK", "ELEVATED RISK", "HIGH RISK (CRITICAL)", "INSUFFICIENT DATA"]
          },
          "categoryScores": {
            "type": "object",
            "description": "Risk score breakdown by category.",
            "properties": {
              "geopolitical": { "type": "integer" },
              "logistics": { "type": "integer" },
              "weather": { "type": "integer" },
              "market": { "type": "integer" }
            }
          },
          "highlights": {
            "type": "array",
            "description": "Key risk driver summaries extracted from matched articles.",
            "items": {
              "type": "string"
            }
          },
          "matchedArticles": {
            "type": "array",
            "description": "Articles that matched this country's risk assessment.",
            "items": {
              "$ref": "#/components/schemas/NewsArticle"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Structured JSON error response.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code.",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message.",
                "example": "The requested resource was not found."
              },
              "hint": {
                "type": "string",
                "description": "Suggested resolution for the error.",
                "example": "Check the API documentation at /docs for valid endpoints."
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    }
